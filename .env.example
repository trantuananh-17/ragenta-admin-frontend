# ragenta-backend. Owns identity (Better Auth at /v1/auth/*), workspaces,
# billing, usage and the platform admin API. Server-side only: the browser talks
# to this app's own /api/* proxy, so the URL never reaches the bundle.
RAGENTA_API_URL=https://staging-backend.ragenta.cloud

# ragenta-content-backend. Owns everything the marketing site renders.
RAGENTA_CONTENT_API_URL=https://staging-content-backend.ragenta.cloud

# This app's own public URL. Better Auth uses it to build the Google OAuth
# callback, so it must match the origin the browser is actually on.
ADMIN_BASE_URL=http://localhost:3002

# The customer app. Password-reset and invitation mails point at it; the admin
# UI links to it. Read by the browser through window.__env.
APP_BASE_URL=https://staging-frontend.ragenta.cloud

# The marketing site. Content screens link to the published page they edit.
SITE_BASE_URL=https://staging.ragenta.cloud

# Both backends must list this app's origin in their own TRUSTED_ORIGINS, or
# Better Auth refuses the sign-in and CORS refuses the call:
#   ragenta-backend         TRUSTED_ORIGINS=...,http://localhost:3002
#   ragenta-content-backend TRUSTED_ORIGINS=...,http://localhost:3002
